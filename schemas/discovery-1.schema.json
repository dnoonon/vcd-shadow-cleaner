{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "vcd-shadow-cleaner.discovery/1",
  "description": "Output of the 'orgs', 'catalogs' and 'datastores' subcommands. Pass an item's id to --catalog-id / --datastore-id.",
  "type": "object",
  "required": [
    "schema",
    "generated_at",
    "complete",
    "errors",
    "warnings",
    "kind",
    "server",
    "org",
    "counts",
    "items"
  ],
  "properties": {
    "schema": {
      "const": "vcd-shadow-cleaner.discovery/1"
    },
    "generated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "complete": {
      "type": "boolean",
      "description": "true only when every query succeeded; exit 4 when false"
    },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/error"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "kind": {
      "enum": [
        "orgs",
        "catalogs",
        "datastores"
      ]
    },
    "server": {
      "type": [
        "string",
        "null"
      ]
    },
    "org": {
      "type": [
        "string",
        "null"
      ]
    },
    "counts": {
      "type": "object",
      "required": [
        "items"
      ],
      "properties": {
        "items": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "items": {
      "type": "array"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "orgs"
          }
        }
      },
      "then": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/$defs/org"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "catalogs"
          }
        }
      },
      "then": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/$defs/catalog"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "datastores"
          }
        }
      },
      "then": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/$defs/datastore"
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "error": {
      "type": "object",
      "required": [
        "type",
        "message"
      ],
      "properties": {
        "type": {
          "type": "string"
        },
        "stage": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "http_status": {
          "type": [
            "integer",
            "null"
          ]
        },
        "message": {
          "type": "string"
        },
        "server": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "query": {
          "type": "string"
        },
        "by": {
          "enum": [
            "name",
            "id"
          ]
        },
        "reason": {
          "enum": [
            "ambiguous",
            "not_found"
          ]
        },
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "href": {
                "type": "string"
              },
              "org": {
                "type": "string"
              },
              "vcenter": {
                "type": "string"
              },
              "server": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false,
      "description": "One failure. ResolutionError entries (exit 2) carry kind/query/by/reason and the candidates with their IDs."
    },
    "org": {
      "type": "object",
      "required": [
        "id",
        "name",
        "href"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "href": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "catalog": {
      "type": "object",
      "required": [
        "id",
        "name",
        "href",
        "org",
        "org_href",
        "is_shared",
        "is_published"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "href": {
          "type": "string"
        },
        "org": {
          "type": "string"
        },
        "org_href": {
          "type": "string"
        },
        "is_shared": {
          "type": "boolean"
        },
        "is_published": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "datastore": {
      "type": "object",
      "required": [
        "id",
        "name",
        "href",
        "vcenter",
        "vc",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "href": {
          "type": "string"
        },
        "vcenter": {
          "type": "string"
        },
        "vc": {
          "type": "string"
        },
        "type": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
